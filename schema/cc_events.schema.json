{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool Call Event",
  "description": "A single tool call event. One JSON object per line (JSONL).",
  "type": "object",
  "required": ["tool", "epoch"],
  "properties": {
    "tool": {
      "type": "string",
      "description": "Tool name",
      "examples": ["Read", "Write", "Edit", "Bash", "Glob", "Grep", "WebFetch"]
    },
    "target": {
      "type": "string",
      "description": "File path, URL, or command (tool-specific)"
    },
    "session_id": {
      "type": "string",
      "description": "Session identifier"
    },
    "epoch": {
      "type": "number",
      "description": "Unix timestamp (seconds)"
    }
  }
}
